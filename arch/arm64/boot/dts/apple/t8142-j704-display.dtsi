#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>

&dcp {
	apple,notch-height = <74>;

	panel {
		compatible = "apple,panel-j704", "apple,panel-mini-led", "apple,panel";
		width-mm = <302>;
		height-mm = <196>;
		adj-height-mm = <189>;
		apple,max-brightness = <600>;
	};
};

/*
 * DCPEXT1 source 4 can drive any Type-C port, or the fixed ATC2 DP link
 * into the on-board DP-to-HDMI converter (SMC gP0f/gP1a, AOP GPIO41 HPD).
 * The converter's I2C maintenance interface and reset remain firmware-owned,
 * as on the T602x/T604x MacBook Pro boards.
 */
&dcpext1 {
	apple,connector-type = "HDMI-A";
	apple,dptx-phy = <2>;
	apple,typec-dptx-phys = <3 0 1>;
	apple,typec-mux-indices = <4 4 4>;
	mux-index = <4>;
	mux-controls = <&dpxbar3 0>, <&dpxbar0 0>, <&dpxbar1 0>, <&dpxbar2 0>;
	mux-control-names = "typec0", "typec1", "typec2", "dp-xbar";
	phys = <&atcphy3 PHY_TYPE_DP>, <&atcphy0 PHY_TYPE_DP>,
	       <&atcphy1 PHY_TYPE_DP>, <&atcphy2 PHY_TYPE_DP>;
	phy-names = "typec0", "typec1", "typec2", "dp-phy";
	hdmi-hpd-gpios = <&pinctrl_aop 41 GPIO_ACTIVE_HIGH>;
	hdmi-pwren-gpios = <&smc_gpio 15 GPIO_ACTIVE_HIGH>;
	dp2hdmi-pwren-gpios = <&smc_gpio 26 GPIO_ACTIVE_HIGH>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;
			dcpext1_hdmi: endpoint {
				remote-endpoint = <&atcphy2_dp>;
			};
		};
	};

	typec-routes {
		#address-cells = <1>;
		#size-cells = <0>;
		route@0 {
			reg = <0>;
			mode-switch;
			status = "disabled";
			port {
				dcpext1_typec3: endpoint {
					remote-endpoint = <&typec3_display>;
				};
			};
		};
		route@1 {
			reg = <1>;
			mode-switch;
			status = "disabled";
			port {
				dcpext1_typec0: endpoint {
					remote-endpoint = <&typec0_display>;
				};
			};
		};
		route@2 {
			reg = <2>;
			mode-switch;
			status = "disabled";
			port {
				dcpext1_typec1: endpoint {
					remote-endpoint = <&typec1_display>;
				};
			};
		};
	};
};

&atcphy2 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@2 {
			reg = <2>;
			atcphy2_dp: endpoint {
				remote-endpoint = <&dcpext1_hdmi>;
			};
		};
	};
};

&typec0 {
	ports {
		port@3 {
			reg = <3>;
			typec0_display: endpoint {
				remote-endpoint = <&dcpext1_typec0>;
			};
		};
	};
};

&typec1 {
	ports {
		port@3 {
			reg = <3>;
			typec1_display: endpoint {
				remote-endpoint = <&dcpext1_typec1>;
			};
		};
	};
};

&typec3 {
	ports {
		port@3 {
			reg = <3>;
			typec3_display: endpoint {
				remote-endpoint = <&dcpext1_typec3>;
			};
		};
	};
};

/* The report domain holds ATC2_USB and its PMGR parents while in use. */
&pmp_report {
	status = "okay";
};
&ps_atc2_common {
	status = "okay";
};

&ps_atc2_usb_aon {
	status = "okay";
};

&ps_atc2_usb {
	status = "okay";
};

&atcphy2 {
	status = "okay";
};

&dpxbar0 {
	status = "okay";
};

&dpxbar1 {
	status = "okay";
};

&dpxbar2 {
	status = "okay";
};

&dpxbar3 {
	status = "okay";
};

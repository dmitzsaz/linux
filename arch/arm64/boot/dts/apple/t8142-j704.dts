/*
 * Apple MacBook Pro (14-inch, M5, 2025)
 *
 * target-type: J704
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8142.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j704", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5, 2025)";
	chassis-type = "laptop";

	aliases {
		serial0 = &serial0;
		serial1 = &dockchannel;
		nvram = &nvram;
		nvme = &nvme;
		pmp = &pmp;
		mtp = &mtp;
		keyboard = &keyboard;
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		atcphy2 = &atcphy2;
		atcphy3 = &atcphy3;
		usb0 = &dwc3_0;
		usb1 = &dwc3_1;
		usb3 = &dwc3_3;
		wifi0 = &wifi0;
		bluetooth0 = &bluetooth0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			/* Format properties are added by the loader. */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* Filled by the loader. */
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x4 0>; /* Filled by the loader. */
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/* ADT voltage-states1-sram level 9 and voltage-states5-sram levels 19-20. */
&ecluster_opp {
	opp-3048000000 {
		opp-hz = /bits/ 64 <3048000000>;
		opp-level = <9>;
	};
};

&pcluster_opp {
	opp-4512000000 {
		opp-hz = /bits/ 64 <4512000000>;
		opp-level = <19>;
	};

	opp-4608000000 {
		opp-hz = /bits/ 64 <4608000000>;
		opp-level = <20>;
	};
};

/*
 * The 26.x ANS firmware ends the nvme block at 0x10000 (ADT ans reg[9]) and
 * keeps the linear submission queues in the NVMMU block.
 */
&nvme {
	reg = <0x4 0xc5cc0000 0x0 0x10000>,
	      <0x4 0x81600000 0x0 0x4000>,
	      <0x4 0x85cc0000 0x0 0x60000>;
};

/* The loader starts the kernel at EL2 with spin-table: no PSCI idle. */
&cpuidle {
	status = "okay";
};

&serial0 {
	status = "okay";
};

&pinctrl_ap {
	/* Pins the firmware lists as no-restore (ADT gpio0) */
	gpio-reserved-ranges = <78 1>, <136 2>, <163 1>, <203 1>;
};

&smc_gpio {
	/* ADT pKW4(gPxx, template) platform functions */
	apple,function-templates =
		<0x0f 0x800000>,	/* dp2hdmi-gpio0 hdmi_pwr_en */
		<0x10 0x10000>,		/* dp2hdmi-gpio0 reset */
		<0x13 0x800000>,	/* amfm reg_on (Wi-Fi/Bluetooth) */
		<0x19 0x0>,		/* pcie-sdreader sd_pwr_en */
		<0x1a 0x0>,		/* dp2hdmi-gpio0 dp2hdmi_pwr_en */
		<0x1c 0x10000>,		/* multi-touch afe-reset */
		<0x1d 0x10000>;		/* stm stm-reset */
};

&mtp_hid {
	/* ADT dockchannel-mtp/mtp-transport/multi-touch function-afe-reset */
	apple,afe-reset-gpios = <&smc_gpio 0x1c GPIO_ACTIVE_HIGH>;

	stm { };

	multi-touch {
		firmware-name = "apple/tpmtfw-j704.bin";
		apple,power-method = <2>;
	};

	/* Layout is filled by the loader using this machine's own data. */
	keyboard: keyboard { };
};

/*
 * Type-C ports: left-front (ATC0) and left-rear (ATC1) on nub SPMI A0,
 * right (ATC3) on nub SPMI A1. ATC2 has no connector: it drives the HDMI
 * port through a DisplayPort to HDMI converter.
 */
&nub_spmi_a0 {
	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_ss: endpoint {
						remote-endpoint = <&atcphy0_typec>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-rear";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_ss: endpoint {
						remote-endpoint = <&atcphy1_typec>;
					};
				};
			};
		};
	};
};

&ps_nub_spmi_a1 {
	status = "okay";
};

&nub_spmi_a1 {
	status = "okay";

	hpm3: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		typec3: connector {
			compatible = "usb-c-connector";
			label = "USB-C Right";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec3_hs: endpoint {
						remote-endpoint = <&dwc3_3_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec3_ss: endpoint {
						remote-endpoint = <&atcphy3_typec>;
					};
				};
			};
		};
	};
};

&dwc3_0 {
	ports {
		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_hs>;
			};
		};
	};
};

&atcphy0 {
	ports {
		port@0 {
			reg = <0>;
			atcphy0_typec: endpoint {
				remote-endpoint = <&typec0_ss>;
			};
		};
	};
};

&dwc3_1 {
	ports {
		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_hs>;
			};
		};
	};
};

&atcphy1 {
	ports {
		port@0 {
			reg = <0>;
			atcphy1_typec: endpoint {
				remote-endpoint = <&typec1_ss>;
			};
		};
	};
};

&ps_atc3_common {
	status = "okay";
};

&ps_atc3_usb_aon {
	status = "okay";
};

&ps_atc3_usb {
	status = "okay";
};

&dwc3_3_dart_0 {
	status = "okay";
};

&dwc3_3_dart_1 {
	status = "okay";
};

&dwc3_3 {
	status = "okay";

	ports {
		port@0 {
			reg = <0>;
			dwc3_3_hs: endpoint {
				remote-endpoint = <&typec3_hs>;
			};
		};
	};
};

&atcphy3 {
	status = "okay";

	ports {
		port@0 {
			reg = <0>;
			atcphy3_typec: endpoint {
				remote-endpoint = <&typec3_ss>;
			};
		};
	};
};

/*
 * APCIe: port 0 carries the Wi-Fi/Bluetooth module (BCM4388, "linosa"),
 * port 2 the SD card reader (GL9755). PERST# is gpio0 192/194 (ADT
 * pci-bridgeN function-perst), power the SMC functions above.
 */
&ps_st0_aus5_aon {
	status = "okay";
};

&ps_st0_aus5 {
	status = "okay";
	/*
	 * The boot loader trains the APCIe links; the kernel cannot bring the
	 * controller back from a power-off, so it stays on through sleep.
	 */
	apple,sleep-retained;
};

&apcie_dart0 {
	status = "okay";
};

&apcie_dart2 {
	status = "okay";
};

&apcie {
	status = "okay";
};

&apcie_port0 {
	bus-range = <1 1>;
	reset-gpios = <&pinctrl_ap 192 GPIO_ACTIVE_LOW>;
	pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
	status = "okay";

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,linosa";
		/* To be filled by the loader */
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,linosa";
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
	};
};

&apcie_port2 {
	bus-range = <2 2>;
	reset-gpios = <&pinctrl_ap 194 GPIO_ACTIVE_LOW>;
	pwren-gpios = <&smc_gpio 0x19 GPIO_ACTIVE_HIGH>;
	status = "okay";

	sdhci0: mmc@0,0 {
		compatible = "pci17a0,9755";
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		cd-inverted;
		wp-inverted;
	};
};

/*
 * Temperatures come from apple,discover-temperatures (t8142.dtsi), which
 * rules out the fixed temperature lists of hwmon-common/hwmon-laptop.
 */
#include "hwmon-fan.dtsi"

&smc_hwmon {
	fan-F0Ac {
		/* This SMC names the fan mode key in lower case. */
		apple,fan-mode = "F0md";
	};
};

#include "t8142-j704-usb4.dtsi"

#include "t8142-j704-display.dtsi"
#include "t8142-j704-audio.dtsi"

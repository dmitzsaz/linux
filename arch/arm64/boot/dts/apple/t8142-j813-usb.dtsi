#include <dt-bindings/spmi/spmi.h>

/ {
	aliases {
		atcphy0 = &atcphy0;
		usb0 = &dwc3_0;
		atcphy1 = &atcphy1;
		usb1 = &dwc3_1;
	};
};

&nub_spmi_a0 {
	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_ss: endpoint {
						remote-endpoint = <&atcphy0_typec>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-rear";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_ss: endpoint {
						remote-endpoint = <&atcphy1_typec>;
					};
				};
			};
		};
	};
};

&dwc3_0 {
	ports {
		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_hs>;
			};
		};
	};
};

&atcphy0 {
	ports {
		port@0 {
			reg = <0>;
			atcphy0_typec: endpoint {
				remote-endpoint = <&typec0_ss>;
			};
		};
	};
};

&dwc3_1 {
	ports {
		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_hs>;
			};
		};
	};
};

&atcphy1 {
	ports {
		port@0 {
			reg = <0>;
			atcphy1_typec: endpoint {
				remote-endpoint = <&typec1_ss>;
			};
		};
	};
};

				 <&usb4_1_dart 23 0x100 0x0 0x10 0x0>,
				 <&usb4_1_dart 24 0x100 0x0 0x10 0x0>,
				 <&usb4_1_dart 25 0x100 0x0 0x10 0x0>,
				 <&usb4_1_dart 26 0x100 0x0 0x10 0x0>,
				 <&usb4_1_dart 27 0x100 0x0 0x10 0x0>;

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1737 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1738 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1739 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1740 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
